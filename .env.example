DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
DJANGO_DB_LOG_LEVEL=WARNING
DJANGO_TRUST_PROXY=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_PRELOAD=0
POSTGRES_DB=mrp
POSTGRES_USER=mrp
POSTGRES_PASSWORD=mrp
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_APPLICATION_NAME=mrp-django
# Defina para proteger /metrics/ por cabeçalho X-Metrics-Token.
MRP_METRICS_TOKEN=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO
CELERY_TASK_TIME_LIMIT=7200
CELERY_TASK_SOFT_TIME_LIMIT=7000

# 0.9.5 independent audit-anchor storages
MPS_AUDIT_ANCHOR_DIR=/var/lib/mrp/audit_anchors
MPS_AUDIT_ANCHOR_SECONDARY_DIR=/var/lib/mrp/audit_anchors_secondary

# Optional host port overrides. Normal development defaults are 5432/8000 in compose.
# The release gate overrides both to 0 so Docker allocates ephemeral ports.
POSTGRES_HOST_PORT=5432
WEB_HOST_PORT=8000
